# The native input wrapper performs HP access and keeps queued ticks disarmed.
def nativeWolfRegenStop():
    timer = Find('gp_wolf_regen_timer')
    if timer:
        timer.Disable()
    stop = Find('gp_wolf_regen_stop')
    if stop:
        stop.Trigger()


def nativeWolfRegenSetup():
    timers = __main__.FindEntitiesByName('gp_wolf_regen_timer')
    starts = __main__.FindEntitiesByName('gp_wolf_regen_start')
    stops = __main__.FindEntitiesByName('gp_wolf_regen_stop')
    # Disable all heartbeats before dispatching any event. Old serialized maps
    # without the relays fail closed, but ordinary completion must still work.
    for timer in timers:
        timer.Disable()
    if len(timers) != 1 or len(starts) != 1 or len(stops) != 1:
        # Old serialized maps are not migrated; duplicates fail closed.
        for stop in stops:
            stop.Trigger()
        return
    timer = timers[0]
    if G.Werewolf_Dead or getattr(G, 'GP_Wolf_CrushStarted', 0):
        stops[0].Trigger()
        return
    starts[0].Trigger()
    timer.Enable()
